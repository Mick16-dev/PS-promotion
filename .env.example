## Local development
# Copy this file to `.env.local` and fill in values.
# Do NOT commit `.env.local`.
#
# Notes:
# - Prefer https:// endpoints if your n8n instance supports TLS (avoids mixed-content blocks when the app is served over HTTPS).
# - These variables are `NEXT_PUBLIC_*` because they are used in client-side fetch calls.

NEXT_PUBLIC_N8N_CREATE_SHOW_WEBHOOK=https://<your-n8n-host>/webhook/create-show
NEXT_PUBLIC_N8N_SEND_REMINDER_WEBHOOK=https://<your-n8n-host>/webhook/send-reminder
NEXT_PUBLIC_N8N_RESEND_EMAIL_WEBHOOK=https://<your-n8n-host>/webhook/resend-email

# Supabase (client + server via @supabase/ssr)
# Get these from Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Supabase Service Role Key (server-side only — NEVER expose to the browser)
# Used to protect internal/debug API routes
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Artist Portal
NEXT_PUBLIC_ARTIST_PORTAL_URL=https://sr-artist-portal-live.vercel.app
